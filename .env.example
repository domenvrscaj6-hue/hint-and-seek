# Copy this file to .env and fill in your real values.
# Never commit the real .env file — .gitignore already excludes it.

GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.5-flash          # optional: first model to try (this is the default);
#                                         # on 429/404 the fallback models in lib/gemini.js are tried

RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=Hint & Seek <hints@hintandseek.com>

SITE_URL=https://www.hintandseek.com

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

APP_SECRET=replace-with-a-long-random-string-at-least-40-characters

# FEEDBACK_TO=you@example.com            # optional: where feedback-widget emails go (default: EMAIL_FROM)
